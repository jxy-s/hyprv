<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="hyprv_app.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:hyprv_app">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>


            <!--
                Shared theme-aware text styles. Lives at App scope so
                code-built UI (AppSettingsPage::BuildSections) can pick
                them up via Application.Current.Resources.Lookup without
                needing a parent FrameworkElement to walk from.

                Foreground via {ThemeResource} in a Setter is the right
                shape: ThemeResource lookups re-evaluate on a
                RequestedTheme switch. A one-shot direct lookup of the
                brush in code-behind (.Resources().Lookup(...).as<Brush>())
                freezes the brush at construction time and reads white
                in Light theme if the app started in Dark.
            -->
            <Style x:Key="AppSettingsSectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="40" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="AppSettingsHint" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="AppSettingsMonoPath" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!--
                Minimal theme-aware secondary-foreground style for
                code-built text. ThemeResource in the Setter re-resolves
                on RequestedTheme change; assigning the looked-up brush
                directly in code (.Foreground(Resources.Lookup(...))) is
                a one-shot resolve that freezes the brush at the moment
                it ran, leaving text white on Light theme if the app
                started in Dark. Use this Style anywhere code-built
                text wants the "secondary" colour.
            -->
            <Style x:Key="SecondaryText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!--
                Theme-aware Border archetypes for code-built UI.

                The pattern: anywhere code did
                  border.Background(.Lookup(key).as<Brush>())
                  border.BorderBrush(.Lookup(key).as<Brush>())
                the brush gets frozen at construction time and stops
                responding to RequestedTheme switches. Apply one of these
                Styles instead — the ThemeResource Setters DO re-evaluate
                live. For transient hover/press overrides, the code path
                should do .ClearValue(BackgroundProperty()) on pointer-
                exit so the Style's theme-aware brush comes back, rather
                than re-setting a (now stale) brush.
            -->
            <Style x:Key="Pill" TargetType="Border">
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>

            <!-- "InfoCard" — small subtle-fill card used by the info
                 flyout (disk + network adapter entries). Theme-aware
                 Background replaces the prior frozen brush lookup. -->
            <Style x:Key="InfoCard" TargetType="Border">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="8,6,8,6" />
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            </Style>

            <!-- "BorderedCard" — outlined card surface used by NIC rows
                 in the VM settings dialog and similar list items.
                 Combines CardBackground + CardStroke + 1 DIP border. -->
            <Style x:Key="BorderedCard" TargetType="Border">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="10,8,10,8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
