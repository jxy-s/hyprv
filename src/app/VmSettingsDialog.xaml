<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="hyprv_app.VmSettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:hyprv_app"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Virtual Machine Settings"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <!--
        Split-nav layout (matches Hyper-V Manager's Settings dialog):
        ListView of sections on the left, one form per section on the
        right (only the active one is Visible at a time). Future sections
        (Network, Storage, Firmware, Security, Checkpoints) drop in as
        more ListViewItems + matching Grids.

        Density per [[hyprv-ui-density]]: 12pt body, ~28 DIP nav rows,
        compact section titles.
    -->
    <ContentDialog.Resources>
        <!-- Wider than the default ContentDialogMaxWidth (~548) so the
             two-column layout fits without clipping. Bumped to 1040 so the
             content pane (root width minus the 190 nav column) comfortably
             holds the widest rows — e.g. the NIC "Advanced" row's four
             feature checkboxes, which overflowed at the old 780/820. -->
        <x:Double x:Key="ContentDialogMaxWidth">1100</x:Double>

        <!-- Tight ListView rows for the nav. -->
        <x:Double x:Key="ListViewItemMinHeight">28</x:Double>

        <!-- Compact the per-card "Settings" expanders. NOTE: ExpanderMinHeight
             and ExpanderContentPadding are referenced via {StaticResource} in
             the Expander template (resolved once at parse time against
             generic.xaml), so overriding them here does NOTHING. The header
             MinHeight + content Padding are instead set as LOCAL values on each
             Expander instance in MakeAdvancedExpander. The chevron button IS a
             {ThemeResource} (default 32 DIP) and would otherwise force the
             header tall, so shrink it here. -->
        <x:Double x:Key="ExpanderChevronButtonSize">24</x:Double>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <!-- Heading for a subsection within a section (e.g. Boot order /
             Secure Boot inside Firmware). Smaller than SectionTitle. -->
        <Style x:Key="SubSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,8,0,4" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="NavGroupHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CharacterSpacing" Value="40" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="Padding" Value="10,8,10,4" />
        </Style>
    </ContentDialog.Resources>

    <Grid Width="1040" Height="620">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--
            Save-in-progress overlay. Covers the whole dialog body (spans
            both columns) with a translucent backdrop so clicks can't
            reach the form, and centers a ProgressRing + "Saving..." label.
            Visibility toggled from code-behind. The dialog buttons stay
            in their normal location below — ContentDialog auto-disables
            them while a deferral is active.
        -->
        <Border x:Name="savingOverlay"
                Grid.Column="0" Grid.ColumnSpan="2"
                Background="{ThemeResource SmokeFillColorDefaultBrush}"
                Visibility="Collapsed"
                Canvas.ZIndex="10">
            <StackPanel Orientation="Vertical"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10">
                <ProgressRing IsActive="True" Width="36" Height="36" />
                <TextBlock Text="Saving..."
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </StackPanel>
        </Border>

        <!-- Top-level error bar spans both columns (apply failures land
             here regardless of which section the user is on). Inserted
             via a row, not as a banner, so it doesn't push the layout
             when invisible. -->

        <!-- Left navigation. Section names map to right-pane container
             names via the Tag (kept in sync with code-behind switching). -->
        <Border Grid.Column="0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
            <StackPanel>
                <TextBlock Text="HARDWARE" Style="{StaticResource NavGroupHeader}" />
                <ListView x:Name="navHardware"
                          SelectionMode="Single"
                          SelectionChanged="OnNavSelectionChanged">
                    <ListViewItem Tag="memory"      Content="Memory"           FontSize="12" />
                    <ListViewItem Tag="processor"   Content="Processor"        FontSize="12" />
                    <!-- Firmware is Generation 2 only; LoadFromVm collapses
                         this item for Gen 1 VMs (no Secure Boot there). -->
                    <ListViewItem x:Name="navFirmwareItem"
                                  Tag="firmware"    Content="Firmware"         FontSize="12" />
                    <!-- Security (vTPM) is Generation 2 only; LoadFromVm
                         collapses this item for Gen 1 VMs. -->
                    <ListViewItem x:Name="navSecurityItem"
                                  Tag="security"    Content="Security"         FontSize="12" />
                    <ListViewItem Tag="storage"     Content="Storage"          FontSize="12" />
                    <ListViewItem Tag="network"     Content="Network Adapters" FontSize="12" />
                    <ListViewItem Tag="comports"    Content="COM Ports"        FontSize="12" />
                    <ListViewItem Tag="rdp"         Content="Remote Desktop"   FontSize="12" />
                </ListView>

                <TextBlock Text="MANAGEMENT" Style="{StaticResource NavGroupHeader}" Margin="0,8,0,0" />
                <ListView x:Name="navManagement"
                          SelectionMode="Single"
                          SelectionChanged="OnNavSelectionChanged">
                    <ListViewItem Tag="name"        Content="Name"                FontSize="12" />
                    <ListViewItem Tag="autoactions" Content="Automatic Actions"   FontSize="12" />
                    <ListViewItem Tag="checkpoints" Content="Checkpoints"         FontSize="12" />
                    <ListViewItem Tag="smartpaging" Content="Smart Paging"        FontSize="12" />
                    <ListViewItem Tag="integration" Content="Integration Services" FontSize="12" />
                    <ListViewItem Tag="notes"       Content="Notes"               FontSize="12" />
                    <!-- Debugger is hidden unless the global feature toggle is
                         on; LoadFromVm collapses this item otherwise. -->
                    <ListViewItem x:Name="navDebuggerItem"
                                  Tag="debugger" Content="Debugger"             FontSize="12" />
                </ListView>
            </StackPanel>
        </Border>

        <!-- Right content area. The InfoBar sits ABOVE the section content
             so errors are visible regardless of which section is selected.
             Each section is a StackPanel — only one is Visible at a time;
             SwitchSection in code-behind toggles them. -->
        <Grid Grid.Column="1" Padding="16,8,20,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <InfoBar Grid.Row="0"
                     x:Name="errorBar"
                     IsOpen="False"
                     IsClosable="True"
                     Severity="Error"
                     Margin="0,0,0,8" />

            <ScrollViewer Grid.Row="1"
                          VerticalScrollMode="Auto"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Disabled"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid>

                    <!-- NAME / GENERAL section. -->
                    <StackPanel x:Name="sectionName" Spacing="6">
                        <TextBlock Text="Name" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="The virtual machine's display name."
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Margin="0,0,0,4" />
                        <TextBox x:Name="nameBox"
                                 FontSize="12"
                                 MinHeight="28" />
                    </StackPanel>

                    <!-- MEMORY section. -->
                    <StackPanel x:Name="sectionMemory" Spacing="4" Visibility="Collapsed">
                        <TextBlock Text="Memory" Style="{StaticResource SectionTitle}" />
                        <Grid ColumnSpacing="8" RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Startup memory (MB)"
                                       Style="{StaticResource FieldLabel}" />
                            <NumberBox Grid.Row="0" Grid.Column="1"
                                       x:Name="memStartupBox"
                                       Minimum="32" Maximum="262144"
                                       SpinButtonPlacementMode="Inline"
                                       SmallChange="64" LargeChange="1024"
                                       FontSize="12" MinHeight="28" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Dynamic memory"
                                       Style="{StaticResource FieldLabel}" />
                            <ToggleSwitch Grid.Row="1" Grid.Column="1"
                                          x:Name="memDynamicToggle"
                                          OnContent="On" OffContent="Off"
                                          MinHeight="28"
                                          Toggled="OnMemDynamicToggled" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Minimum (MB)"
                                       Style="{StaticResource FieldLabel}" />
                            <NumberBox Grid.Row="2" Grid.Column="1"
                                       x:Name="memMinBox"
                                       Minimum="32" Maximum="262144"
                                       SpinButtonPlacementMode="Inline"
                                       SmallChange="64" LargeChange="1024"
                                       FontSize="12" MinHeight="28" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Maximum (MB)"
                                       Style="{StaticResource FieldLabel}" />
                            <NumberBox Grid.Row="3" Grid.Column="1"
                                       x:Name="memMaxBox"
                                       Minimum="32" Maximum="1048576"
                                       SpinButtonPlacementMode="Inline"
                                       SmallChange="64" LargeChange="1024"
                                       FontSize="12" MinHeight="28" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Memory buffer (%)"
                                       Style="{StaticResource FieldLabel}" />
                            <NumberBox Grid.Row="4" Grid.Column="1"
                                       x:Name="memBufferBox"
                                       Minimum="5" Maximum="2000"
                                       SpinButtonPlacementMode="Inline"
                                       SmallChange="1" LargeChange="10"
                                       FontSize="12" MinHeight="28" />

                            <!-- Memory weight as a Low-High slider. Hyper-V
                                 Manager exposes 9 stops, but the WMI Weight is
                                 0..10000, so we allow the full range in 100-steps
                                 (ticks at the 9 HVM positions) with a live value
                                 readout. -->
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Memory weight"
                                       Style="{StaticResource FieldLabel}" />
                            <Grid Grid.Row="5" Grid.Column="1" ColumnSpacing="8"
                                  VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Low" FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Slider Grid.Column="1" x:Name="memWeightSlider"
                                        Minimum="0" Maximum="10000"
                                        StepFrequency="100" SmallChange="100" LargeChange="1250"
                                        TickFrequency="1250" TickPlacement="Outside"
                                        SnapsTo="StepValues"
                                        VerticalAlignment="Center"
                                        ValueChanged="OnMemWeightChanged" />
                                <TextBlock Grid.Column="2" Text="High" FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="3" x:Name="memWeightValueText"
                                           Text="5000" FontSize="12"
                                           MinWidth="42" TextAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Grid>
                    </StackPanel>

                    <!-- PROCESSOR section. -->
                    <StackPanel x:Name="sectionProcessor" Spacing="4" Visibility="Collapsed">
                        <TextBlock Text="Processor" Style="{StaticResource SectionTitle}" />
                        <Grid ColumnSpacing="8" RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Virtual processors"
                                       Style="{StaticResource FieldLabel}" />
                            <NumberBox Grid.Row="0" Grid.Column="1"
                                       x:Name="cpuCountBox"
                                       Minimum="1" Maximum="240"
                                       SpinButtonPlacementMode="Inline"
                                       SmallChange="1" LargeChange="4"
                                       FontSize="12" MinHeight="28"
                                       HorizontalAlignment="Left" Width="180"
                                       ValueChanged="OnProcessorResourceChanged" />

                            <!-- Reserve/Limit: half-width box + the read-only
                                 "% of total resources" inline to its right
                                 (Hyper-V Manager shows this derived figure). -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Reserve (%)"
                                       Style="{StaticResource FieldLabel}" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                <NumberBox x:Name="cpuReservationBox"
                                           Minimum="0" Maximum="100"
                                           SpinButtonPlacementMode="Inline"
                                           SmallChange="1" LargeChange="10"
                                           FontSize="12" MinHeight="28" Width="180"
                                           ValueChanged="OnProcessorResourceChanged" />
                                <TextBlock x:Name="cpuReserveTotalText"
                                           Text="0% of total" FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Limit (%)"
                                       Style="{StaticResource FieldLabel}" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                <NumberBox x:Name="cpuLimitBox"
                                           Minimum="0" Maximum="100"
                                           SpinButtonPlacementMode="Inline"
                                           SmallChange="1" LargeChange="10"
                                           FontSize="12" MinHeight="28" Width="180"
                                           ValueChanged="OnProcessorResourceChanged" />
                                <TextBlock x:Name="cpuLimitTotalText"
                                           Text="100% of total" FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Relative weight (0-10000)"
                                       Style="{StaticResource FieldLabel}" />
                            <NumberBox Grid.Row="3" Grid.Column="1"
                                       x:Name="cpuWeightBox"
                                       Minimum="0" Maximum="10000"
                                       SpinButtonPlacementMode="Inline"
                                       SmallChange="10" LargeChange="100"
                                       FontSize="12" MinHeight="28"
                                       HorizontalAlignment="Left" Width="180" />
                        </Grid>

                        <!-- Compatibility (Msvm_ProcessorSettingData.
                             LimitProcessorFeatures). VM must be Off. -->
                        <TextBlock Text="Compatibility" Style="{StaticResource SubSectionTitle}"
                                   Margin="0,8,0,0" />
                        <CheckBox x:Name="cpuCompatCheck"
                                  Content="Migrate to a physical computer with a different processor version"
                                  FontSize="12" MinHeight="26" />
                        <TextBlock Text="Limit the processor features this virtual machine can use, to improve compatibility with different processor versions."
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,4" />

                        <!-- NUMA topology caps. Processor fields live on the
                             processor setting; max memory per node on the memory
                             setting (MaxMemoryBlocksPerNumaNode, MB). VM Off. -->
                        <TextBlock Text="NUMA topology" Style="{StaticResource SubSectionTitle}"
                                   Margin="0,8,0,0" />
                        <Grid ColumnSpacing="8" RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Max processors per node"
                                       Style="{StaticResource FieldLabel}" />
                            <NumberBox Grid.Row="0" Grid.Column="1"
                                       x:Name="numaMaxProcsBox"
                                       Minimum="1" Maximum="256"
                                       SpinButtonPlacementMode="Inline"
                                       SmallChange="1" LargeChange="4"
                                       FontSize="12" MinHeight="28"
                                       HorizontalAlignment="Left" Width="180" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Max memory per node (MB)"
                                       Style="{StaticResource FieldLabel}" />
                            <NumberBox Grid.Row="1" Grid.Column="1"
                                       x:Name="numaMaxMemoryBox"
                                       Minimum="8" Maximum="4194304"
                                       SpinButtonPlacementMode="Inline"
                                       SmallChange="256" LargeChange="2048"
                                       FontSize="12" MinHeight="28"
                                       HorizontalAlignment="Left" Width="180" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Max NUMA nodes per socket"
                                       Style="{StaticResource FieldLabel}" />
                            <NumberBox Grid.Row="2" Grid.Column="1"
                                       x:Name="numaMaxNodesBox"
                                       Minimum="1" Maximum="64"
                                       SpinButtonPlacementMode="Inline"
                                       SmallChange="1" LargeChange="4"
                                       FontSize="12" MinHeight="28"
                                       HorizontalAlignment="Left" Width="180" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Hardware threads per core"
                                       Style="{StaticResource FieldLabel}" />
                            <NumberBox Grid.Row="3" Grid.Column="1"
                                       x:Name="numaThreadsBox"
                                       Minimum="0" Maximum="2"
                                       SpinButtonPlacementMode="Inline"
                                       SmallChange="1" LargeChange="1"
                                       FontSize="12" MinHeight="28"
                                       HorizontalAlignment="Left" Width="180" />
                        </Grid>
                        <TextBlock Text="Specify 0 for hardware threads per core to inherit the host setting."
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,2,0,4" />
                        <Button x:Name="numaUseHwTopologyButton"
                                Content="Use hardware topology"
                                FontSize="12" Margin="0,2,0,0"
                                Click="OnUseHardwareTopology" />
                        <TextBlock Text="Resets the virtual NUMA topology to match this host's processors and memory."
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>

                    <!--
                        FIRMWARE section (Generation 2 only). Two subsections:
                        Boot order (reorder the firmware BootSourceOrder via
                        VMManager::Get/SetBootOrder) and Secure Boot (toggle +
                        CA template via VMManager::SetSecureBoot). Both go
                        through ModifySystemSettings on the realised VSSD and
                        want the VM Off. The whole section is hidden for Gen 1
                        VMs (LoadFromVm collapses navFirmwareItem).
                    -->
                    <StackPanel x:Name="sectionFirmware" Spacing="4" Visibility="Collapsed">
                        <TextBlock x:Name="firmwareSectionTitle" Text="Firmware" Style="{StaticResource SectionTitle}" />

                        <!-- Boot order. bootOrderList is populated in
                             LoadFromVm from GetBootOrder; Move Up/Down reorder
                             the selected entry. Save diffs the ref order and
                             writes via SetBootOrder. -->
                        <TextBlock Text="Boot order" Style="{StaticResource SubSectionTitle}" />
                        <TextBlock Text="Select an entry and use the buttons to change the boot order."
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,4" />
                        <Grid x:Name="bootOrderGrid" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ListView x:Name="bootOrderList"
                                      Grid.Column="0"
                                      SelectionMode="Single"
                                      Height="132"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                      BorderThickness="1" />
                            <StackPanel Grid.Column="1" Spacing="6"
                                        VerticalAlignment="Top" Width="110">
                                <Button x:Name="bootUpButton"
                                        Content="Move up"
                                        HorizontalAlignment="Stretch"
                                        FontSize="12"
                                        Click="OnBootMoveUp" />
                                <Button x:Name="bootDownButton"
                                        Content="Move down"
                                        HorizontalAlignment="Stretch"
                                        FontSize="12"
                                        Click="OnBootMoveDown" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="bootOrderEmptyText"
                                   Text="This VM has no configurable boot entries."
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="Collapsed" />
                    </StackPanel>

                    <!--
                        SECURITY section (Generation 2 only). vTPM toggle +
                        "encrypt state and migration traffic". Enabling vTPM
                        provisions a local key protector under the hood. Both
                        settings require the VM to be Off (ApplyStateGating).
                    -->
                    <StackPanel x:Name="sectionSecurity" Spacing="4" Visibility="Collapsed">
                        <TextBlock Text="Security" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="A virtual TPM lets the guest use BitLocker and other TPM-backed features."
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6" />

                        <Grid ColumnSpacing="8" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Trusted Platform Module"
                                       Style="{StaticResource FieldLabel}" />
                            <ToggleSwitch Grid.Row="0" Grid.Column="1"
                                          x:Name="tpmToggle"
                                          OnContent="On" OffContent="Off"
                                          MinHeight="28" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Encrypt state and traffic"
                                       Style="{StaticResource FieldLabel}" />
                            <ToggleSwitch Grid.Row="1" Grid.Column="1"
                                          x:Name="encryptStateToggle"
                                          OnContent="On" OffContent="Off"
                                          MinHeight="28" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Enable shielding"
                                       Style="{StaticResource FieldLabel}" />
                            <ToggleSwitch Grid.Row="2" Grid.Column="1"
                                          x:Name="shieldToggle"
                                          OnContent="On" OffContent="Off"
                                          MinHeight="28"
                                          Toggled="OnShieldingToggled" />
                        </Grid>
                        <TextBlock Text="Shielding turns on the virtual TPM and state encryption (required), and restricts host-console access. Full protection requires a Host Guardian Service; without one this is a local (untrusted) shield."
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,2,0,0" />

                        <!-- Secure Boot — Gen 2 firmware feature, grouped under
                             Security to match Hyper-V Manager (the whole Security
                             nav item is hidden for Gen 1). -->
                        <TextBlock Text="Secure Boot" Style="{StaticResource SubSectionTitle}"
                                   Margin="0,8,0,0" />
                        <TextBlock Text="Secure Boot allows only trusted, signed boot binaries to run."
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6" />
                        <Grid ColumnSpacing="8" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Enable Secure Boot"
                                       Style="{StaticResource FieldLabel}" />
                            <ToggleSwitch Grid.Row="0" Grid.Column="1"
                                          x:Name="secureBootToggle"
                                          OnContent="On" OffContent="Off"
                                          MinHeight="28"
                                          Toggled="OnSecureBootToggled" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Template"
                                       Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Row="1" Grid.Column="1"
                                      x:Name="secureBootTemplateCombo"
                                      FontSize="12" MinHeight="28" Width="300"
                                      HorizontalAlignment="Left">
                                <ComboBoxItem Content="Microsoft Windows" />
                                <ComboBoxItem Content="Microsoft UEFI Certificate Authority" />
                                <ComboBoxItem Content="Open Source Shielded VM" />
                            </ComboBox>

                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       Text="Choose &quot;Microsoft UEFI Certificate Authority&quot; for Linux guests; &quot;Microsoft Windows&quot; for Windows."
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>

                    <!--
                        STORAGE section. Hard drives are listed read-only;
                        DVD drives get a mount/change/eject affordance. Both
                        the per-drive cards (DVD: path box + Browse + Eject)
                        and the read-only HDD rows are built in LoadFromVm.
                        DVD media hot-swaps, so no VM-state gating here.
                    -->
                    <StackPanel x:Name="sectionStorage" Spacing="4" Visibility="Collapsed">
                        <TextBlock Text="Storage" Style="{StaticResource SectionTitle}" />

                        <!-- Controllers: the VM's SCSI/IDE controllers, each a
                             row built in code (numbered label + a Remove button
                             for SCSI controllers that are empty). Disks/DVDs are
                             placed onto these when added. Add/Remove are Off-only
                             and applied immediately (not Save-batched) so the
                             device-placement flyouts always see real controllers. -->
                        <TextBlock Text="Controllers" Style="{StaticResource SubSectionTitle}" />
                        <StackPanel x:Name="storageControllerHost" Spacing="4" />
                        <Button x:Name="storageAddScsiButton"
                                Content="Add SCSI controller"
                                FontSize="12" Margin="0,2,0,0"
                                Click="OnStorageAddScsiController" />

                        <TextBlock Text="Hard drives" Style="{StaticResource SubSectionTitle}" />
                        <StackPanel x:Name="storageHddHost" Spacing="6" />
                        <TextBlock x:Name="storageHddEmptyText"
                                   Text="No virtual hard disks attached."
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="Collapsed" />
                        <!-- Pending attaches (queued by "Attach VHD..."),
                             applied at Save. -->
                        <StackPanel x:Name="storageAttachHost" Spacing="6" />
                        <!-- Attach an existing VHD, or create a new one. Each
                             button opens a small popup (a Flyout — WinUI can't
                             stack a second ContentDialog over the settings
                             dialog) that picks the target controller + slot
                             before the file step. The combos are repopulated on
                             each open (Opening) so free slots exclude both VM-
                             used and already-queued slots. -->
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Button x:Name="storageAttachButton"
                                    Content="Attach VHD..."
                                    FontSize="12">
                                <Button.Flyout>
                                    <Flyout x:Name="attachVhdFlyout" Opening="OnAttachFlyoutOpening">
                                        <StackPanel Spacing="10" MinWidth="260">
                                            <TextBlock Text="Attach existing VHD"
                                                       FontSize="13" FontWeight="SemiBold" />
                                            <ComboBox x:Name="attachControllerCombo"
                                                      Header="Controller" FontSize="12"
                                                      HorizontalAlignment="Stretch"
                                                      SelectionChanged="OnPlacementControllerChanged" />
                                            <ComboBox x:Name="attachSlotCombo"
                                                      Header="Location" FontSize="12"
                                                      HorizontalAlignment="Stretch" />
                                            <Button Content="Browse &amp; attach..."
                                                    FontSize="12"
                                                    HorizontalAlignment="Right"
                                                    Click="OnStorageAttachVhd" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <Button x:Name="storageCreateButton"
                                    Content="Create new VHD..."
                                    FontSize="12">
                                <Button.Flyout>
                                    <Flyout x:Name="newVhdFlyout" Opening="OnCreateFlyoutOpening">
                                        <StackPanel Spacing="10" MinWidth="260">
                                            <TextBlock Text="New virtual hard disk"
                                                       FontSize="13" FontWeight="SemiBold" />
                                            <NumberBox x:Name="newVhdSizeBox"
                                                       Header="Maximum size (GB)"
                                                       Value="40" Minimum="1" Maximum="65536"
                                                       SpinButtonPlacementMode="Inline"
                                                       SmallChange="1" LargeChange="10"
                                                       FontSize="12" />
                                            <CheckBox x:Name="newVhdDynamicCheck"
                                                      Content="Dynamically expanding"
                                                      IsChecked="True" FontSize="12" />
                                            <ComboBox x:Name="createControllerCombo"
                                                      Header="Controller" FontSize="12"
                                                      HorizontalAlignment="Stretch"
                                                      SelectionChanged="OnPlacementControllerChanged" />
                                            <ComboBox x:Name="createSlotCombo"
                                                      Header="Location" FontSize="12"
                                                      HorizontalAlignment="Stretch" />
                                            <Button x:Name="newVhdCreateButton"
                                                    Content="Choose location &amp; create..."
                                                    FontSize="12"
                                                    HorizontalAlignment="Right"
                                                    Click="OnStorageCreateVhd" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <!-- Pass-through: attach an OFFLINE host physical
                                 disk (no VHD file). The disk picker lists offline
                                 host disks; placement combos like the others. -->
                            <Button x:Name="storagePhysAttachButton"
                                    Content="Attach physical disk..."
                                    FontSize="12">
                                <Button.Flyout>
                                    <Flyout x:Name="physDiskFlyout" Opening="OnPhysFlyoutOpening">
                                        <StackPanel Spacing="10" Width="360">
                                            <TextBlock Text="Attach physical disk (pass-through)"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock x:Name="physNoDisksText"
                                                       Text="No offline physical disks are available."
                                                       FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Visibility="Collapsed" />
                                            <ComboBox x:Name="physDiskCombo"
                                                      Header="Physical disk" FontSize="12"
                                                      HorizontalAlignment="Stretch" />
                                            <ComboBox x:Name="physControllerCombo"
                                                      Header="Controller" FontSize="12"
                                                      HorizontalAlignment="Stretch"
                                                      SelectionChanged="OnPlacementControllerChanged" />
                                            <ComboBox x:Name="physSlotCombo"
                                                      Header="Location" FontSize="12"
                                                      HorizontalAlignment="Stretch" />
                                            <Button x:Name="physAttachButton"
                                                    Content="Attach"
                                                    FontSize="12"
                                                    HorizontalAlignment="Right"
                                                    Click="OnStorageAttachPhysical" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>

                        <TextBlock Text="DVD drives" Style="{StaticResource SubSectionTitle}" />
                        <StackPanel x:Name="storageDvdHost" Spacing="6" />
                        <TextBlock x:Name="storageDvdEmptyText"
                                   Text="This VM has no DVD drives."
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                        <!-- Pending new DVD drives (queued by "Add DVD drive"),
                             added at Save. -->
                        <StackPanel x:Name="storageDvdAddHost" Spacing="6" />
                        <Button x:Name="storageDvdAddButton"
                                Content="Add DVD drive"
                                FontSize="12"
                                Margin="0,4,0,0">
                            <Button.Flyout>
                                <Flyout x:Name="addDvdFlyout" Opening="OnDvdFlyoutOpening">
                                    <StackPanel Spacing="10" MinWidth="260">
                                        <TextBlock Text="Add DVD drive"
                                                   FontSize="13" FontWeight="SemiBold" />
                                        <ComboBox x:Name="dvdControllerCombo"
                                                  Header="Controller" FontSize="12"
                                                  HorizontalAlignment="Stretch"
                                                  SelectionChanged="OnPlacementControllerChanged" />
                                        <ComboBox x:Name="dvdSlotCombo"
                                                  Header="Location" FontSize="12"
                                                  HorizontalAlignment="Stretch" />
                                        <Button Content="Add"
                                                FontSize="12"
                                                HorizontalAlignment="Right"
                                                Click="OnStorageAddDvdDrive" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                    <!-- NETWORK ADAPTERS section. Per-NIC cards populated
                         dynamically in LoadFromVm: switch connection, MAC
                         (static/dynamic), access VLAN, and a per-card Remove.
                         "Add adapter..." queues a new NIC (added at Save).
                         Add/Remove are gated to VM Off; switch/MAC/VLAN edits
                         are live. -->
                    <StackPanel x:Name="sectionNetwork" Spacing="4" Visibility="Collapsed">
                        <TextBlock Text="Network Adapters" Style="{StaticResource SectionTitle}" />
                        <StackPanel x:Name="networkAdaptersHost" Spacing="6" />
                        <TextBlock x:Name="networkEmptyText"
                                   Text="This VM has no network adapters."
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="Collapsed" />
                        <!-- Pending new adapters (queued by "Add adapter..."),
                             added at Save. -->
                        <StackPanel x:Name="networkAddHost" Spacing="6" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Button x:Name="networkAddButton"
                                    Content="Add adapter..."
                                    FontSize="12">
                                <Button.Flyout>
                                    <Flyout x:Name="addNicFlyout">
                                        <StackPanel Spacing="10" MinWidth="240">
                                            <TextBlock Text="New network adapter"
                                                       FontSize="13" FontWeight="SemiBold" />
                                            <ComboBox x:Name="addNicSwitchCombo"
                                                      Header="Connect to"
                                                      FontSize="12" MinHeight="28"
                                                      HorizontalAlignment="Stretch" />
                                            <Button x:Name="addNicConfirmButton"
                                                    Content="Add"
                                                    FontSize="12"
                                                    HorizontalAlignment="Right"
                                                    Click="OnNetworkAddAdapter" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- INTEGRATION SERVICES section. CheckBoxes populated
                         dynamically in LoadFromVm. -->
                    <StackPanel x:Name="sectionIntegration" Spacing="4" Visibility="Collapsed">
                        <TextBlock Text="Integration Services" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Select the services you would like the guest OS to receive."
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Margin="0,0,0,6" />
                        <StackPanel x:Name="integrationServicesHost" Spacing="2" />
                    </StackPanel>

                    <!--
                        RDP section. Lives in the HARDWARE nav group even
                        though it doesn't touch Hyper-V at all — these are
                        hyprv-side preferences (Settings::vmPrefs.<guid>.rdpOptions)
                        that drive the RdpOptions wire payload passed to
                        hyprv-rdphost.exe on connect. Same controls as the
                        App Settings "RDP defaults" section; per-VM here
                        overrides the app-wide defaults when "Use app defaults"
                        is off. State-gating: with the override toggle ON
                        (use defaults), the rest of the section is disabled.
                    -->
                    <StackPanel x:Name="sectionRdp" Spacing="4" Visibility="Collapsed">
                        <TextBlock Text="Remote Desktop" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Overrides for this session. Defaults come from Settings → Remote Desktop. Saving reconnects an open session for this VM so the changes apply right away."
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6" />

                        <Grid ColumnSpacing="8" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Use app defaults"
                                       Style="{StaticResource FieldLabel}" />
                            <ToggleSwitch Grid.Row="0" Grid.Column="1"
                                          x:Name="rdpUseDefaultsToggle"
                                          OnContent="On" OffContent="Off"
                                          MinHeight="28"
                                          Toggled="OnRdpUseDefaultsToggled" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Audio playback"
                                       Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Row="1" Grid.Column="1"
                                      x:Name="rdpAudioModeCombo"
                                      FontSize="12" MinHeight="28" Width="240"
                                      HorizontalAlignment="Left">
                                <ComboBoxItem Content="Play on this computer" />
                                <ComboBoxItem Content="Play on the VM" />
                                <ComboBoxItem Content="Mute (no audio)" />
                            </ComboBox>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Microphone capture"
                                       Style="{StaticResource FieldLabel}" />
                            <CheckBox Grid.Row="2" Grid.Column="1"
                                      x:Name="rdpAudioCaptureCheck"
                                      FontSize="12" MinHeight="26" VerticalAlignment="Center"
                                      Content="Send local microphone audio to the VM" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Clipboard"
                                       Style="{StaticResource FieldLabel}" />
                            <CheckBox Grid.Row="3" Grid.Column="1"
                                      x:Name="rdpClipboardCheck"
                                      FontSize="12" MinHeight="26" VerticalAlignment="Center"
                                      Content="Share clipboard with the VM" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Drives"
                                       Style="{StaticResource FieldLabel}" />
                            <CheckBox Grid.Row="4" Grid.Column="1"
                                      x:Name="rdpDrivesCheck"
                                      FontSize="12" MinHeight="26" VerticalAlignment="Center"
                                      Content="Share local drives with the VM" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Devices"
                                       Style="{StaticResource FieldLabel}" />
                            <CheckBox Grid.Row="5" Grid.Column="1"
                                      x:Name="rdpDevicesCheck"
                                      FontSize="12" MinHeight="26" VerticalAlignment="Center"
                                      Content="Share USB / Plug-and-Play devices" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Smart cards"
                                       Style="{StaticResource FieldLabel}" />
                            <CheckBox Grid.Row="6" Grid.Column="1"
                                      x:Name="rdpSmartCardsCheck"
                                      FontSize="12" MinHeight="26" VerticalAlignment="Center"
                                      Content="Share smart cards" />

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Ports"
                                       Style="{StaticResource FieldLabel}" />
                            <CheckBox Grid.Row="7" Grid.Column="1"
                                      x:Name="rdpPortsCheck"
                                      FontSize="12" MinHeight="26" VerticalAlignment="Center"
                                      Content="Share serial / parallel ports" />

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Color depth"
                                       Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Row="8" Grid.Column="1"
                                      x:Name="rdpColorDepthCombo"
                                      FontSize="12" MinHeight="28" Width="180"
                                      HorizontalAlignment="Left">
                                <ComboBoxItem Content="16 bpp" />
                                <ComboBoxItem Content="24 bpp" />
                                <ComboBoxItem Content="32 bpp" />
                            </ComboBox>

                            <TextBlock Grid.Row="9" Grid.Column="0" Text="Display scale"
                                       Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Row="9" Grid.Column="1"
                                      x:Name="rdpScaleCombo"
                                      FontSize="12" MinHeight="28" Width="180"
                                      HorizontalAlignment="Left">
                                <ComboBoxItem Content="Auto" />
                                <ComboBoxItem Content="100%" />
                                <ComboBoxItem Content="125%" />
                                <ComboBoxItem Content="150%" />
                                <ComboBoxItem Content="175%" />
                                <ComboBoxItem Content="200%" />
                            </ComboBox>

                            <TextBlock Grid.Row="10" Grid.Column="0" Text="Initial size"
                                       Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Row="10" Grid.Column="1"
                                      x:Name="rdpResolutionCombo"
                                      FontSize="12" MinHeight="28" Width="180"
                                      HorizontalAlignment="Left"
                                      ToolTipService.ToolTip="Applies to basic-session guests; enhanced sessions fit the tab window.">
                                <ComboBoxItem Content="800 x 600" />
                                <ComboBoxItem Content="1024 x 768" />
                                <ComboBoxItem Content="1280 x 720" />
                                <ComboBoxItem Content="1280 x 1024" />
                                <ComboBoxItem Content="1366 x 768" />
                                <ComboBoxItem Content="1600 x 900" />
                                <ComboBoxItem Content="1920 x 1080" />
                                <ComboBoxItem Content="2560 x 1440" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>

                    <!-- NOTES section. -->
                    <StackPanel x:Name="sectionNotes" Spacing="4" Visibility="Collapsed">
                        <TextBlock Text="Notes" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Free-form description of this VM."
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Margin="0,0,0,4" />
                        <TextBox x:Name="notesBox"
                                 FontSize="12"
                                 MinHeight="200"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- AUTOMATIC ACTIONS section. What Hyper-V does to this VM
                         when the host starts up / shuts down. Plain config prefs,
                         changeable in any VM state. Combo indices map to WMI
                         enum values in LoadFromVm / OnPrimaryButtonClick. -->
                    <StackPanel x:Name="sectionAutoActions" Spacing="4" Visibility="Collapsed">
                        <TextBlock Text="Automatic Actions" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="What Hyper-V does to this VM when the host boots or shuts down."
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6" />

                        <Grid ColumnSpacing="8" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="When the host starts"
                                       Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      x:Name="autoStartCombo"
                                      FontSize="12" MinHeight="28" Width="280"
                                      HorizontalAlignment="Left">
                                <ComboBoxItem Content="Nothing" />
                                <ComboBoxItem Content="Start if previously running" />
                                <ComboBoxItem Content="Always start automatically" />
                            </ComboBox>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="When the host shuts down"
                                       Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Row="1" Grid.Column="1"
                                      x:Name="autoStopCombo"
                                      FontSize="12" MinHeight="28" Width="280"
                                      HorizontalAlignment="Left">
                                <ComboBoxItem Content="Turn off the VM" />
                                <ComboBoxItem Content="Save the VM state" />
                                <ComboBoxItem Content="Shut down the guest OS" />
                            </ComboBox>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Startup delay (seconds)"
                                       Style="{StaticResource FieldLabel}" />
                            <NumberBox Grid.Row="2" Grid.Column="1"
                                       x:Name="autoStartDelayBox"
                                       FontSize="12" MinHeight="28" Width="140"
                                       HorizontalAlignment="Left"
                                       Minimum="0" Maximum="86400"
                                       SpinButtonPlacementMode="Hidden" />
                        </Grid>
                    </StackPanel>

                    <!-- CHECKPOINTS section. Checkpoint type (UserSnapshotType)
                         is changeable any time; the file location
                         (SnapshotDataRoot) only when the VM has no checkpoints
                         (LoadFromVm gates the box + shows the hint). -->
                    <StackPanel x:Name="sectionCheckpoints" Spacing="4" Visibility="Collapsed">
                        <TextBlock Text="Checkpoints" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Checkpoint type and where checkpoint files are stored."
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6" />

                        <Grid ColumnSpacing="8" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Checkpoint type"
                                       Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      x:Name="checkpointTypeCombo"
                                      FontSize="12" MinHeight="28" Width="320"
                                      HorizontalAlignment="Left">
                                <ComboBoxItem Content="Production with standard fallback" />
                                <ComboBoxItem Content="Production only" />
                                <ComboBoxItem Content="Standard" />
                                <ComboBoxItem Content="Disabled" />
                            </ComboBox>

                            <CheckBox Grid.Row="1" Grid.Column="1"
                                      x:Name="automaticCheckpointsCheck"
                                      FontSize="12" MinHeight="26" VerticalAlignment="Center"
                                      Content="Use automatic checkpoints" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="File location"
                                       Style="{StaticResource FieldLabel}" />
                            <Grid Grid.Row="2" Grid.Column="1" ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="checkpointLocationBox"
                                         FontSize="12" MinHeight="28" />
                                <Button Grid.Column="1" x:Name="checkpointBrowseButton"
                                        Content="Browse..." FontSize="12"
                                        Click="OnCheckpointBrowse" />
                            </Grid>

                            <TextBlock Grid.Row="3" Grid.Column="1"
                                       x:Name="checkpointLocationHint"
                                       Text="The file location can only be changed while the VM has no checkpoints."
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed" />
                        </Grid>
                    </StackPanel>

                    <!-- SMART PAGING section. The temporary smart-paging file
                         location (SwapFileDataRoot). Plain path config. -->
                    <StackPanel x:Name="sectionSmartPaging" Spacing="4" Visibility="Collapsed">
                        <TextBlock Text="Smart Paging" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Where Hyper-V writes the temporary smart paging file, used at boot when a dynamic-memory VM is under memory pressure."
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="File location"
                                       Style="{StaticResource FieldLabel}" />
                            <Grid Grid.Column="1" ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="smartPagingLocationBox"
                                         FontSize="12" MinHeight="28" />
                                <Button Grid.Column="1" x:Name="smartPagingBrowseButton"
                                        Content="Browse..." FontSize="12"
                                        Click="OnSmartPagingBrowse" />
                            </Grid>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="sectionComPorts" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="COM Ports" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Connect a virtual COM port to a named pipe on the host. Leave blank to disconnect. Changes take effect after the VM is turned off and started again."
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="COM 1" Width="48"
                                       Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="com1PathBox" Width="320"
                                     PlaceholderText="\\.\pipe\..."
                                     FontSize="12" MinHeight="28" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="COM 2" Width="48"
                                       Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="com2PathBox" Width="320"
                                     PlaceholderText="\\.\pipe\..."
                                     FontSize="12" MinHeight="28" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="sectionDebugger" Spacing="4" Visibility="Collapsed">
                        <TextBlock Text="Debugger" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Launch an external debugger for this VM from the title-bar button. Leave Debugger blank to use the global default. The button is enabled once arguments are set; you supply the transport in the arguments (e.g. a KDNET or named-pipe connection string)."
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Debugger"
                                       Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" x:Name="debuggerExeBox"
                                     PlaceholderText="windbgx"
                                     FontSize="12" MinHeight="28" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Arguments"
                                       Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" x:Name="debuggerArgsBox"
                                     PlaceholderText="-k net:port=...,key=... -T VMNAME"
                                     FontSize="12" MinHeight="28" />
                        </Grid>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>

</ContentDialog>
