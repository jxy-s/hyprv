<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="hyprv_app.VmTabPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:hyprv_app"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">

    <!--
        Per-VM tab content. Layered children (bottom to top):
          rdpHost   — anchor for the cross-process mstscax popup. Transparent
                      so when the popup is hidden the panel below shows through.
                      The popup is a top-level Win32 window owned by hyprv's
                      HWND, positioned by code-behind over this Border's rect.
          infoRoot  — the SINGLE, ALWAYS-PRESENT info surface. It always shows
                      the VM name (one element, one font/colour/position) and
                      toggles a spinner + status line + hint + Start/Retry
                      buttons beneath it per state. It is never collapsed:
                        • not connected → user sees name + status here;
                        • connected     → the rdpHost popup covers it on-screen,
                          but it still feeds the VM name into the DWM taskbar /
                          Alt-Tab thumbnail (DWM captures THIS XAML window, not
                          the separate cross-process popup window).
                      Earlier this was two elements (a dim "watermark" name +
                      a separate brighter placeholder name) which looked
                      inconsistent and double-drew; collapsed to one here.

        Rail / flyout / window chrome live on MainWindow — this UserControl is
        intentionally minimal so tab-tear-away can re-parent it into a new
        MainWindow without dragging window-level state along.
    -->
    <Grid>
        <Border x:Name="rdpHost" Background="Transparent" />

        <!--
            Single info surface. Two equal rows split at the vertical centre:
            the name is BOTTOM-anchored in the top row (so it sits just above
            centre and NEVER moves whether or not a status line is present),
            the status group is TOP-anchored in the bottom row. Background is
            Transparent so the window SystemBackdrop (Mica/Acrylic tint from
            ApplyAppearance) shows through. IsHitTestVisible is toggled off in
            code while a session is live so the transparent surface can't eat
            clicks in the popup's letterbox margins.
        -->
        <Grid x:Name="infoRoot" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="placeholderVmName"
                       Grid.Row="0"
                       FontSize="28"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="600" />
            <StackPanel x:Name="placeholderStatusGroup"
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Spacing="6"
                        MaxWidth="500"
                        Margin="0,16,0,0"
                        Padding="24,0,24,0">
                <ProgressRing x:Name="placeholderSpinner"
                              IsActive="True"
                              Width="36" Height="36"
                              HorizontalAlignment="Center"
                              Visibility="Collapsed" />
                <TextBlock x:Name="placeholderState"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="placeholderHint"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,12,0,0"
                           Visibility="Collapsed"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <Button x:Name="placeholderStart"
                        Click="OnPlaceholderStartClick"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="Segoe MDL2 Assets"
                                  Glyph="&#xE768;" FontSize="14" />
                        <TextBlock Text="Start" />
                    </StackPanel>
                </Button>
                <!--
                    Shown by UpdatePlaceholderAndClient / ShowConnectError when a
                    connect attempt to a Running VM fails repeatedly (a fatal RDP
                    disconnect, or an rdphost startup/protocol error). The error
                    text lands in placeholderHint above; this button re-attempts
                    the connection from a clean slate. Non-modal by design — a
                    dialog popping during reconnect churn would be hostile.
                -->
                <Button x:Name="placeholderRetry"
                        Click="OnPlaceholderRetryClick"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="Segoe MDL2 Assets"
                                  Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Retry" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>

</UserControl>
