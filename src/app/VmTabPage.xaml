<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="hyprv_app.VmTabPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:hyprv_app"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">

    <!--
        Per-VM tab content. Two layered children:
          rdpHost   — anchor for the cross-process mstscax popup. Transparent
                      so when the popup is hidden the placeholder shows through.
                      The popup is a top-level Win32 window owned by hyprv's
                      HWND, positioned by code-behind over this Border's rect.
          placeholderRoot — shown when the VM isn't connectable (off, saved,
                      paused, transitioning, missing). Centered VM name +
                      state + Start button. Hidden when the rdphost popup is
                      live so it doesn't bleed through the popup edges.

        Rail / flyout / window chrome live on MainWindow — this UserControl is
        intentionally minimal so tab-tear-away can re-parent it into a new
        MainWindow without dragging window-level state along.
    -->
    <Grid>
        <Border x:Name="rdpHost" Background="Transparent" />

        <!--
            Cold-start loading overlay. Shown when this tab was restored
            from settings.json but VMManager hasn't completed its first
            WMI poll yet (so vmOpt is null but the VM may very well still
            exist — we just don't know yet). Same visual idiom as the
            WelcomePage's inline allVmsLoading spinner so a user with both
            restored sees a consistent "we're connecting to Hyper-V" state.
            VmTabPage::UpdatePlaceholderAndClient hides this once the
            first VMManager snapshot lands; thereafter the placeholderRoot
            below takes over (either with VM state or "(missing VM)").
        -->
        <StackPanel x:Name="loadingOverlay"
                    Orientation="Vertical"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12"
                    Visibility="Collapsed">
            <ProgressRing IsActive="True"
                          Width="48" Height="48"
                          HorizontalAlignment="Center" />
            <TextBlock Text="Loading VM..."
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!--
            Background=Transparent so the window's chosen SystemBackdrop
            (Mica / Acrylic, with the per-theme tint set by ApplyAppearance)
            shows through. ApplicationPageBackgroundThemeBrush was opaque
            and theme-mismatched (extra-light in Light, too-light in Dark,
            not-black in Black) — the per-theme tint computed at the window
            level is the source of truth for "background colour", so the
            placeholder needs to inherit it rather than pick its own.
        -->
        <Grid x:Name="placeholderRoot"
              Visibility="Collapsed"
              Background="Transparent">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="6"
                        MaxWidth="500"
                        Padding="24">
                <TextBlock x:Name="placeholderVmName"
                           FontSize="28"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="placeholderState"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="placeholderHint"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,12,0,0"
                           Visibility="Collapsed"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <Button x:Name="placeholderStart"
                        Click="OnPlaceholderStartClick"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="Segoe MDL2 Assets"
                                  Glyph="&#xE768;" FontSize="14" />
                        <TextBlock Text="Start" />
                    </StackPanel>
                </Button>
                <!--
                    Shown by UpdatePlaceholderAndClient / ShowConnectError when a
                    connect attempt to a Running VM fails repeatedly (a fatal RDP
                    disconnect, or an rdphost startup/protocol error). The error
                    text lands in placeholderHint above; this button re-attempts
                    the connection from a clean slate. Non-modal by design — a
                    dialog popping during reconnect churn would be hostile.
                -->
                <Button x:Name="placeholderRetry"
                        Click="OnPlaceholderRetryClick"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="Segoe MDL2 Assets"
                                  Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Retry" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>

</UserControl>
