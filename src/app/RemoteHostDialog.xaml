<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="hyprv_app.RemoteHostDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:hyprv_app"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Remote host"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">720</x:Double>
        <!-- Without this the dialog clips (not scrolls) when the RDP-options
             expander is open and the body exceeds the default max (gotcha #39). -->
        <x:Double x:Key="ContentDialogMaxHeight">860</x:Double>
        <!-- Compact the "Remote Desktop options" expander chrome to match the
             rest of the app. The chevron button (default 32) floors the header
             height and IS a {ThemeResource}, so a scoped override shrinks it;
             MinHeight + content Padding are set locally on the Expander
             (they're {StaticResource} in the template — gotcha #37). -->
        <x:Double x:Key="ExpanderChevronButtonSize">24</x:Double>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </ContentDialog.Resources>

    <Grid Width="540">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <InfoBar Grid.Row="0"
                 x:Name="errorBar"
                 IsOpen="False"
                 IsClosable="True"
                 Severity="Error"
                 Margin="0,0,0,8" />

        <StackPanel Grid.Row="1" Spacing="2">
            <Grid ColumnSpacing="8" RowSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Display name"
                           Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="nameBox"
                         FontSize="12" MinHeight="28"
                         PlaceholderText="Optional — defaults to the address" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Computer"
                           Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="addressBox"
                         FontSize="12" MinHeight="28"
                         PlaceholderText="Host name or IP address (e.g. 192.168.1.50)" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Port"
                           Style="{StaticResource FieldLabel}" />
                <NumberBox Grid.Row="2" Grid.Column="1" x:Name="portBox"
                           Value="3389" Minimum="1" Maximum="65535"
                           SpinButtonPlacementMode="Inline"
                           SmallChange="1" LargeChange="10"
                           FontSize="12" MinHeight="28"
                           HorizontalAlignment="Left" Width="160" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="User name"
                           Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="userBox"
                         FontSize="12" MinHeight="28"
                         PlaceholderText="Optional — pre-fills the sign-in prompt" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Domain"
                           Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="domainBox"
                         FontSize="12" MinHeight="28"
                         PlaceholderText="Optional" />
            </Grid>

            <TextBlock Style="{StaticResource HintText}"
                       Margin="0,12,0,0"
                       Text="You'll be asked for your password each time you connect — hyprv never stores it. Windows can still remember it via its own sign-in prompt." />

            <!-- Per-host Remote Desktop options. Collapsed by default so the form
                 stays compact; a new host seeds these from Settings → Remote
                 Desktop defaults, an edit shows the host's saved values. -->
            <Expander x:Name="rdpExpander"
                      Margin="0,14,0,0"
                      MinHeight="28"
                      Padding="12,8,12,10"
                      FontSize="12"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      IsExpanded="False">
                <Expander.Header>
                    <TextBlock Text="Remote Desktop options" FontSize="12" />
                </Expander.Header>
                <StackPanel Spacing="10" Margin="0,4,0,4">
                    <Grid ColumnSpacing="8" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Audio"
                                   Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="rdpAudioCombo"
                                  FontSize="12" MinHeight="28" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Play on this computer" />
                            <ComboBoxItem Content="Play on the remote PC" />
                            <ComboBoxItem Content="Mute (no audio)" />
                        </ComboBox>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Color depth"
                                   Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="rdpColorCombo"
                                  FontSize="12" MinHeight="28" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="16 bpp" />
                            <ComboBoxItem Content="24 bpp" />
                            <ComboBoxItem Content="32 bpp" />
                        </ComboBox>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Display scale"
                                   Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="rdpScaleCombo"
                                  FontSize="12" MinHeight="28" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Auto" />
                            <ComboBoxItem Content="100%" />
                            <ComboBoxItem Content="125%" />
                            <ComboBoxItem Content="150%" />
                            <ComboBoxItem Content="175%" />
                            <ComboBoxItem Content="200%" />
                        </ComboBox>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Initial size"
                                   Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="rdpSizeCombo"
                                  FontSize="12" MinHeight="28" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="800 x 600" />
                            <ComboBoxItem Content="1024 x 768" />
                            <ComboBoxItem Content="1280 x 720" />
                            <ComboBoxItem Content="1280 x 1024" />
                            <ComboBoxItem Content="1366 x 768" />
                            <ComboBoxItem Content="1600 x 900" />
                            <ComboBoxItem Content="1920 x 1080" />
                            <ComboBoxItem Content="2560 x 1440" />
                        </ComboBox>
                    </Grid>

                    <TextBlock Text="Redirect to the remote PC"
                               Style="{StaticResource HintText}" Margin="0,2,0,0" />
                    <Grid ColumnSpacing="16" RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <CheckBox Grid.Row="0" Grid.Column="0" x:Name="rdpClipboardCheck"
                                  Content="Clipboard" FontSize="12" MinHeight="26" />
                        <CheckBox Grid.Row="0" Grid.Column="1" x:Name="rdpDrivesCheck"
                                  Content="Drives" FontSize="12" MinHeight="26" />
                        <CheckBox Grid.Row="0" Grid.Column="2" x:Name="rdpDevicesCheck"
                                  Content="USB / PnP devices" FontSize="12" MinHeight="26" />
                        <CheckBox Grid.Row="1" Grid.Column="0" x:Name="rdpSmartCardsCheck"
                                  Content="Smart cards" FontSize="12" MinHeight="26" />
                        <CheckBox Grid.Row="1" Grid.Column="1" x:Name="rdpPortsCheck"
                                  Content="Ports" FontSize="12" MinHeight="26" />
                        <CheckBox Grid.Row="1" Grid.Column="2" x:Name="rdpMicCheck"
                                  Content="Microphone" FontSize="12" MinHeight="26" />
                    </Grid>
                </StackPanel>
            </Expander>
        </StackPanel>
    </Grid>

</ContentDialog>
