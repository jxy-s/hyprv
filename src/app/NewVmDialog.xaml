<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="hyprv_app.NewVmDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:hyprv_app"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="New Virtual Machine"
    PrimaryButtonText="Create"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <!--
        Single-column wizard form (the project's density philosophy favours a
        compact "see everything at once" layout over a multi-step click-through).
        Sections: Name & generation, Memory & processor, Storage, Network,
        Installation media. Create runs VMManager::CreateVM; the new VM's
        GUID/name are read back by MainWindow::OpenNewVmDialog to open a tab.
    -->
    <ContentDialog.Resources>
        <!-- Match the Virtual Machine Settings dialog's footprint for a
             consistent feel across the two modals. The MaxHeight override is
             essential: the default ContentDialogMaxHeight is smaller than our
             620-DIP body + title + buttons, so without it the dialog compresses
             the content area below 620, the fixed-height Grid overflows, and the
             last rows get clipped (unreachable even at max scroll). -->
        <x:Double x:Key="ContentDialogMaxWidth">1100</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">900</x:Double>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,6" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </ContentDialog.Resources>

    <Grid Width="1040" Height="620">

        <!-- Create-in-progress overlay (mirrors VmSettingsDialog's saving
             overlay): translucent backdrop + centered spinner while the WMI
             create batch + poll wait run. The dialog buttons auto-disable
             during the active deferral. -->
        <Border x:Name="creatingOverlay"
                Background="{ThemeResource SmokeFillColorDefaultBrush}"
                Visibility="Collapsed"
                Canvas.ZIndex="10">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10">
                <ProgressRing IsActive="True" Width="36" Height="36" />
                <TextBlock Text="Creating virtual machine..."
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </StackPanel>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <InfoBar Grid.Row="0"
                     x:Name="errorBar"
                     IsOpen="False"
                     IsClosable="True"
                     Severity="Error"
                     Margin="0,0,0,8" />

            <ScrollViewer Grid.Row="1"
                          VerticalScrollMode="Auto"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Disabled"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="2" Padding="2,0,12,8">

                    <!-- NAME + GENERATION -->
                    <TextBlock Text="Name and generation"
                               Style="{StaticResource SectionTitle}"
                               Margin="0,0,0,6" />
                    <Grid ColumnSpacing="8" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 x:Name="nameBox"
                                 FontSize="12" MinHeight="28"
                                 PlaceholderText="New virtual machine"
                                 TextChanged="OnNameChanged" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Generation"
                                   Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  x:Name="genCombo"
                                  FontSize="12" MinHeight="28"
                                  HorizontalAlignment="Left" Width="240"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="Generation 2" />
                            <ComboBoxItem Content="Generation 1" />
                        </ComboBox>
                    </Grid>
                    <TextBlock Style="{StaticResource HintText}"
                               Text="Generation 2 uses UEFI firmware with Secure Boot and suits modern 64-bit guests. Generation 1 uses legacy BIOS for older operating systems. This cannot be changed later." />

                    <!-- MEMORY + PROCESSOR -->
                    <TextBlock Text="Memory and processor"
                               Style="{StaticResource SectionTitle}" />
                    <Grid ColumnSpacing="8" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Startup memory (MB)"
                                   Style="{StaticResource FieldLabel}" />
                        <StackPanel Grid.Row="0" Grid.Column="1"
                                    Orientation="Horizontal" Spacing="8">
                            <NumberBox x:Name="memBox"
                                       Value="2048" Minimum="32" Maximum="1048576"
                                       SpinButtonPlacementMode="Inline"
                                       SmallChange="256" LargeChange="1024"
                                       FontSize="12" MinHeight="28"
                                       Width="240" />
                            <!-- Quick-pick: selecting a common amount fills the
                                 box (Tag = MB). Saves the GB->MB mental math. -->
                            <ComboBox x:Name="memPresetCombo"
                                      PlaceholderText="Preset"
                                      FontSize="12" MinHeight="28" Width="120"
                                      VerticalAlignment="Center"
                                      SelectionChanged="OnMemoryPresetChanged">
                                <ComboBoxItem Content="1 GB"  Tag="1024" />
                                <ComboBoxItem Content="2 GB"  Tag="2048" />
                                <ComboBoxItem Content="4 GB"  Tag="4096" />
                                <ComboBoxItem Content="8 GB"  Tag="8192" />
                                <ComboBoxItem Content="16 GB" Tag="16384" />
                                <ComboBoxItem Content="32 GB" Tag="32768" />
                            </ComboBox>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Dynamic memory"
                                   Style="{StaticResource FieldLabel}" />
                        <CheckBox Grid.Row="1" Grid.Column="1"
                                  x:Name="dynamicMemCheck"
                                  IsChecked="True"
                                  Content="Let Hyper-V adjust memory automatically"
                                  FontSize="12" MinHeight="26"
                                  VerticalAlignment="Center" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Virtual processors"
                                   Style="{StaticResource FieldLabel}" />
                        <NumberBox Grid.Row="2" Grid.Column="1"
                                   x:Name="cpuBox"
                                   Value="2" Minimum="1" Maximum="240"
                                   SpinButtonPlacementMode="Inline"
                                   SmallChange="1" LargeChange="4"
                                   FontSize="12" MinHeight="28"
                                   HorizontalAlignment="Left" Width="240" />
                    </Grid>

                    <!-- STORAGE -->
                    <TextBlock Text="Storage" Style="{StaticResource SectionTitle}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Hard disk"
                                   Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Column="1"
                                  x:Name="diskModeCombo"
                                  SelectedIndex="0"
                                  FontSize="12" MinHeight="28"
                                  HorizontalAlignment="Left" Width="320"
                                  SelectionChanged="OnDiskModeChanged">
                            <ComboBoxItem Content="Create a virtual hard disk" />
                            <ComboBoxItem Content="Use an existing virtual hard disk" />
                            <ComboBoxItem Content="Attach a hard disk later" />
                        </ComboBox>
                    </Grid>

                    <!-- Create-new sub-panel -->
                    <StackPanel x:Name="createDiskPanel" Spacing="6" Margin="0,6,0,0">
                        <Grid ColumnSpacing="8" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Maximum size (GB)"
                                       Style="{StaticResource FieldLabel}" />
                            <NumberBox Grid.Row="0" Grid.Column="1"
                                       x:Name="diskSizeBox"
                                       Value="127" Minimum="1" Maximum="65536"
                                       SpinButtonPlacementMode="Inline"
                                       SmallChange="1" LargeChange="10"
                                       FontSize="12" MinHeight="28"
                                       HorizontalAlignment="Left" Width="240" />

                            <CheckBox Grid.Row="1" Grid.Column="1"
                                      x:Name="diskDynamicCheck"
                                      IsChecked="True"
                                      Content="Dynamically expanding"
                                      FontSize="12" MinHeight="26"
                                      VerticalAlignment="Center" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Location"
                                       Style="{StaticResource FieldLabel}" />
                            <Grid Grid.Row="2" Grid.Column="1" ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="diskPathBox"
                                         FontSize="12" MinHeight="28"
                                         PlaceholderText="Choose where the .vhdx is created" />
                                <Button Grid.Column="1" Content="Browse..."
                                        FontSize="12"
                                        Click="OnBrowseNewDisk" />
                            </Grid>
                        </Grid>
                    </StackPanel>

                    <!-- Use-existing sub-panel -->
                    <StackPanel x:Name="existingDiskPanel" Spacing="6"
                                Margin="0,6,0,0" Visibility="Collapsed">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Virtual hard disk"
                                       Style="{StaticResource FieldLabel}" />
                            <Grid Grid.Column="1" ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="existingDiskBox"
                                         FontSize="12" MinHeight="28"
                                         PlaceholderText="Select an existing .vhdx / .vhd" />
                                <Button Grid.Column="1" Content="Browse..."
                                        FontSize="12"
                                        Click="OnBrowseExistingDisk" />
                            </Grid>
                        </Grid>
                    </StackPanel>

                    <!-- NETWORK -->
                    <TextBlock Text="Network" Style="{StaticResource SectionTitle}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Connection"
                                   Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Column="1"
                                  x:Name="switchCombo"
                                  FontSize="12" MinHeight="28"
                                  HorizontalAlignment="Left" Width="320" />
                    </Grid>

                    <!-- INSTALLATION MEDIA -->
                    <TextBlock Text="Installation media"
                               Style="{StaticResource SectionTitle}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Image file (ISO)"
                                   Style="{StaticResource FieldLabel}" />
                        <Grid Grid.Column="1" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="isoBox"
                                     FontSize="12" MinHeight="28"
                                     PlaceholderText="Optional: an .iso to boot for OS install" />
                            <Button Grid.Column="1" Content="Browse..."
                                    FontSize="12"
                                    Click="OnBrowseIso" />
                        </Grid>
                    </Grid>
                    <TextBlock Style="{StaticResource HintText}"
                               Text="Optional. The VM boots from this disc the first time it starts so you can install an operating system." />

                    <!-- LOCATION -->
                    <TextBlock Text="Location" Style="{StaticResource SectionTitle}" />
                    <CheckBox x:Name="customLocationCheck"
                              Content="Store the virtual machine in a different location"
                              FontSize="12" MinHeight="26"
                              Checked="OnCustomLocationToggled"
                              Unchecked="OnCustomLocationToggled" />
                    <Grid ColumnSpacing="8" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Folder"
                                   Style="{StaticResource FieldLabel}" />
                        <Grid Grid.Column="1" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="vmLocationBox"
                                     FontSize="12" MinHeight="28"
                                     IsEnabled="False" />
                            <Button Grid.Column="1" x:Name="vmLocationBrowse"
                                    Content="Browse..." FontSize="12"
                                    IsEnabled="False"
                                    Click="OnBrowseVmLocation" />
                        </Grid>
                    </Grid>
                    <TextBlock Style="{StaticResource HintText}"
                               Text="By default the VM is stored in the host's configured folder. Checkpoints and the smart paging file are kept here too." />

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>

</ContentDialog>
