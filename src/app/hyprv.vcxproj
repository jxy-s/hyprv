  <PropertyGroup Label="Globals">
    <!-- We deliberately omit the Microsoft.WindowsAppSDK.AI transitive sub-package
         (hyprv uses no Windows AI/ML APIs; its runtime bits live in the framework
         package regardless). The WindowsAppSDK umbrella's transitive-dependency
         verifier errors on the omission, so disable it (Microsoft's documented
         escape hatch, named in that very error). If you ever ADD an AI/ML feature,
         restore the Microsoft.WindowsAppSDK.AI package + its imports and remove this. -->
    <WindowsAppSDKVerifyTransitiveDependencies>false</WindowsAppSDKVerifyTransitiveDependencies>
