    <EnableMsixTooling>false</EnableMsixTooling>
    <!-- Debug = UNPACKAGED for fast dev iteration: the bootstrap initializer locates
         the installed Windows App SDK runtime on the dev box and the exe runs directly.
         Release = PACKAGED MSIX, built + packaged by src/package/hyprv-package.wapproj.
         WindowsPackageType=MSIX so WinUI/WinRT initializes for a PACKAGED app (an
         unpackaged-built binary crashes packaged). FRAMEWORK-DEPENDENT (NOT
         self-contained): the WinApp SDK runtime — including the WinUI framework
         resources (ms-appx:///Microsoft.UI.Xaml/Themes/themeresources.xaml) and WinRT
         activation registrations — is supplied by the Microsoft.WindowsAppRuntime
         FRAMEWORK package declared as a PackageDependency. Self-contained MSIX was
         tried and abandoned: the .wapproj tooling does NOT merge those framework
         resources/registrations into a self-contained package, so the packaged app
         fail-fasts at WinUI startup ("Cannot locate resource …themeresources.xaml",
         stowed 0x802b000a — confirmed via windbg). Bootstrap MUST stay OFF (packaged
         apps resolve the runtime via the framework dependency, not the bootstrapper). -->
    <WindowsPackageType Condition="'$(Configuration)'=='Debug'">None</WindowsPackageType>
    <WindowsPackageType Condition="'$(Configuration)'=='Release'">MSIX</WindowsPackageType>
    <WindowsAppSdkBootstrapInitialize Condition="'$(Configuration)'=='Debug'">true</WindowsAppSdkBootstrapInitialize>
    <WindowsAppSdkBootstrapInitialize Condition="'$(Configuration)'=='Release'">false</WindowsAppSdkBootstrapInitialize>
    <!-- Final exe is hyprv.exe, regardless of the project's display name. -->
    <TargetName>hyprv</TargetName>
