// Win32 resource script — embeds the app icon so Explorer / taskbar /
// Alt-Tab use it. Lowest-numbered ICON resource wins for the Explorer
// thumbnail, by convention that's ID 1.
//
// Don't include winres.h here: the C++/WinRT build doesn't have the legacy
// SDK headers on its rc.exe include path, and we don't need any of the
// constants from there for a single-icon resource.

101 ICON "..\\resources\\hyprv.ico"

// Version resource — populates Explorer ▸ Properties ▸ Details (File description,
// version, Product name, Copyright). No header include (this rc.exe lacks the legacy
// SDK headers on its include path), so the fixed-info fields are numeric literals:
// 0x40004 = VOS_NT_WINDOWS32, 0x1 = VFT_APP. String VALUEs are kept ASCII so the
// encoding can't mangle them. Keep the versions in sync with the MSIX package
// version in src/package/Package.appxmanifest (Identity Version).
1 VERSIONINFO
 FILEVERSION    1,0,0,1
 PRODUCTVERSION 1,0,0,1
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         0x40004L
 FILETYPE       0x1L
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "jxy-s"
            VALUE "FileDescription",  "hyprv - Hyper-V Manager"
            VALUE "FileVersion",      "1.0.0.1"
            VALUE "InternalName",     "hyprv"
            VALUE "LegalCopyright",   "Copyright (C) 2026 jxy-s"
            VALUE "OriginalFilename", "hyprv.exe"
            VALUE "ProductName",      "hyprv"
            VALUE "ProductVersion",   "1.0.0.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
