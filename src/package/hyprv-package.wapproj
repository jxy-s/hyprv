<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup>
    <WapProjPath Condition="'$(WapProjPath)'==''">$(MSBuildExtensionsPath)\Microsoft\DesktopBridge\</WapProjPath>
  </PropertyGroup>
  <Import Project="$(WapProjPath)\Microsoft.DesktopBridge.props" />
  <PropertyGroup>
    <ProjectGuid>7f3e2a10-9c4b-4d8e-a1f2-3b6c5d4e7f80</ProjectGuid>
    <TargetPlatformVersion>10.0.26100.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <DefaultLanguage>en-US</DefaultLanguage>
    <EntryPointProjectUniqueName>..\app\hyprv.vcxproj</EntryPointProjectUniqueName>
    <!-- Framework-dependent: the app project (Release) is NOT self-contained, so the
         WinApp SDK runtime — incl. the WinUI framework resources + WinRT registrations —
         comes from the Microsoft.WindowsAppRuntime FRAMEWORK package declared as a
         PackageDependency. (Self-contained MSIX was abandoned: the tooling doesn't
         merge the framework resources into the package → WinUI startup fail-fast.) -->
    <!-- We sign separately with Trusted Signing (signtool + Azure dlib), not here. -->
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxAutoIncrementPackageRevision>false</AppxAutoIncrementPackageRevision>
    <AppxBundle>Never</AppxBundle>
    <AppxBundlePlatforms>x64</AppxBundlePlatforms>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
    <!-- Final .msix lands here (gitignored). -->
    <AppxPackageDir>$(SolutionDir)dist\msix\</AppxPackageDir>
    <OutDir>$(SolutionDir)src\obj\$(MSBuildProjectName)\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)src\obj\$(MSBuildProjectName)\$(Platform)\$(Configuration)\</IntDir>
  </PropertyGroup>
  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\**\*.*" />
    <!-- The out-of-process RDP host EXE, placed at the package ROOT next to
         hyprv.exe (where FindRdphost looks). hyprv-rdphost is deliberately NOT a
         ProjectReference: a ProjectReference to a plain Win32 exe project lands its
         output in a hyprv-rdphost/ SUBfolder, duplicating this root copy. The build
         script (tools/make-msix.ps1) builds rdphost BEFORE this project so the file
         exists when packaging runs. -->
    <Content Include="$(SolutionDir)bin\$(Platform)\$(Configuration)\hyprv-rdphost.exe">
      <Link>hyprv-rdphost.exe</Link>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <!-- EntryPoint app only. (rdphost is included as <Content> above, not a
         reference — see the note there.) -->
    <ProjectReference Include="..\app\hyprv.vcxproj">
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(WapProjPath)\Microsoft.DesktopBridge.targets" />
</Project>
