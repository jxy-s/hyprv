// rdphost shares the main app's icon — it never appears as a foreground
// window for the user, but Task Manager + handle dialogs still pick this
// up so the child process is recognisable.

101 ICON "..\\resources\\hyprv.ico"

// Version resource — see the note in src/app/hyprv.rc. Numeric fixed-info literals
// (0x40004 = VOS_NT_WINDOWS32, 0x1 = VFT_APP); keep versions in sync with the MSIX
// package version (src/package/Package.appxmanifest).
1 VERSIONINFO
 FILEVERSION    1,0,0,1
 PRODUCTVERSION 1,0,0,1
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         0x40004L
 FILETYPE       0x1L
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "jxy-s"
            VALUE "FileDescription",  "hyprv RDP host"
            VALUE "FileVersion",      "1.0.0.1"
            VALUE "InternalName",     "hyprv-rdphost"
            VALUE "LegalCopyright",   "Copyright (C) 2026 jxy-s"
            VALUE "OriginalFilename", "hyprv-rdphost.exe"
            VALUE "ProductName",      "hyprv"
            VALUE "ProductVersion",   "1.0.0.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
