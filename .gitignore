# ---- MSBuild / VS build output ----
# bin/ sits at the repo root (next to src/) — final exe + pdb + winmd land here.
# obj/ sits inside src/ — intermediate per-project files (.pch, .obj, generated headers, etc.).
bin/
src/obj/
# dist/ — packaged distribution output (self-contained ZIP / staging), generated.
dist/
# Belt-and-braces in case any project ever emits to its own dir:
x64/
x86/
ARM64/
Win32/
Debug/
Release/

# The build-output patterns above (Debug/, Release/, x64/, …) are case-insensitive
# on Windows and would otherwise swallow hand-authored config dirs like
# `.claude/skills/release/`. `.claude/` is all tracked config — always include it.
!.claude/
!.claude/**
# …except per-machine local settings, which stay untracked.
.claude/settings.local.json

# ---- VS / Intellisense state ----
.vs/
*.vcxproj.user
*.user
*.suo
*.aps
*.opensdf
*.sdf
*.tlog

# ---- NuGet ----
packages/

# ---- WinUI XAML codegen + AppX intermediate ----
Generated Files/

# ---- Build artifacts ----
*.exp
*.pdb
*.idb
*.ilk
*.lib
*.recipe
*.ipdb
*.iobj
*.obj
*.winmd.lastbuild

# ---- App-local logs / settings (in case a dev runs out of the repo) ----
*.log
settings.json
